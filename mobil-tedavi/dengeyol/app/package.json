{
  "name": "dengeyol",
  "private": true,
  "version": "0.1.0",
  "description": "DengeYol — BPPV (iyi huylu pozisyonel baş dönmesi) için telefon sensörlü manevra rehberi; hasta ve odyolog modu.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/run-e2e.mjs",
    "icons": "node scripts/make-icons.mjs",
    "docs:protocols": "vite-node scripts/protocol-table.ts"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "typescript": "5.6",
    "vite": "5.4",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "2.1"
  }
}
